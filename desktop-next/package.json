{
  "name": "vanta-desktop-next",
  "private": true,
  "version": "0.0.0",
  "description": "Vanta Desktop next-generation shell: imported Hermes desktop (MIT) re-skinned with the Vanta design and wired to Vanta's server.",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "parity": "node tools/parity/check-app.mjs --electron",
    "parity:spec": "node tools/parity/extract-spec.mjs",
    "parity:selftest": "node tools/parity/selftest.mjs",
    "parity:test": "node --test tools/parity/*.test.mjs",
    "vanta:build": "node tools/build-vanta.mjs",
    "vanta:app": "node tools/launch-vanta.mjs",
    "vanta:reach": "node tools/reachability.mjs",
    "vanta:shots": "node tools/shoot-restore.mjs && node tools/shoot-native.mjs",
    "vanta:package": "node tools/package-vanta.mjs",
    "vanta:package:test": "node --test tools/packaging/*.test.mjs"
  }
}
