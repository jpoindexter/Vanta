diff --git a/desktop-next/apps/desktop/src/components/ui/button-icon-size.test.tsx b/desktop-next/apps/desktop/src/components/ui/button-icon-size.test.tsx
new file mode 100644
index 00000000..0460dfac
--- /dev/null
+++ b/desktop-next/apps/desktop/src/components/ui/button-icon-size.test.tsx
@@ -0,0 +1,19 @@
+import { cleanup, render } from '@testing-library/react'
+import { afterEach, describe, expect, it } from 'vitest'
+
+import { Button } from './button'
+
+afterEach(cleanup)
+
+describe('Button icon size ownership', () => {
+  it.each([
+    ['default', '3.5'],
+    ['xs', '3'],
+    ['icon-titlebar', '(--titlebar-icon-size)']
+  ] as const)('%s keeps only its winning glyph rule', (size, expected) => {
+    const { getByRole } = render(<Button aria-label="Control" size={size}><svg /></Button>)
+    const rules = getByRole('button').className.split(' ').filter(rule => rule.startsWith('[&_svg:not('))
+
+    expect(rules).toEqual([`[&_svg:not([class*='size-'])]:size-${expected}`])
+  })
+})
