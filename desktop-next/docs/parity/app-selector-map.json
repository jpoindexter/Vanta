   },
   {
    "wait": 2600
   }
  ],
  "wb:changes": [
   {
    "eval": "window.__vantaFixture({workbench:'changes'})"
   },
   {
    "wait": 400
   }
  ],
  "wb:files": [
   {
    "eval": "window.__vantaFixture({workbench:'files'})"
   },
   {
    "wait": 400
   }
  ],
  "wb:browser": [
   {
    "eval": "window.__vantaFixture({workbench:'browser'})"
   },
