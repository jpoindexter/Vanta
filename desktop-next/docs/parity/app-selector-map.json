{
 "version": 1,
 "target": "app (apps/desktop, Hermes shell)",
 "description": "Selector map for the built Vanta Desktop renderer. Keys are the wireframe role keys; UNMAPPED means the app has no hook yet. See docs/parity/README.md.",
 "viewport": {
  "mode": "frame"
 },
 "prepare": {
  "css": "*,*::before,*::after{animation:none!important;transition:none!important;caret-color:transparent!important;scrollbar-width:none!important}"
 },
 "copyRoot": {
  "css": "#root"
 },
 "drivers": {
  "base": [
   {
    "storage": {
     "key": "hermes-desktop-mode-v1",
     "value": "light"
    }
   },
   {
    "reload": true
   },
   {
    "waitFor": {
     "css": "[data-vanta-titlebar]"
    },
    "timeout": 120000
   },
   {
    "eval": "new Promise(r=>{const t=setInterval(()=>{if(typeof window.__vantaFixture==='function'){clearInterval(t);r()}},100)})"
   },
   {
    "wait": 600
   }
  ],
  "w:1440": [],
  "w:1100": [],
  "w:800": [],
  "chat:empty": [
   {
    "eval": "window.__vantaFixture({chat:'empty'})"
   },
   {
    "wait": 2600
   }
  ],
  "chat:running": [
   {
    "eval": "window.__vantaFixture({chat:'running'})"
   },
   {
    "wait": 2600
   }
  ],
