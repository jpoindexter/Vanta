{
  "name": "vanta-website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "gen:roadmap": "node scripts/gen-roadmap.mjs",
    "prestart": "node scripts/gen-roadmap.mjs",
    "prebuild": "node scripts/image-build-security.mjs && node scripts/gen-roadmap.mjs && node scripts/sync-model-catalog.mjs && cp ../bootstrap.sh static/install.sh",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "npm run build && npx --yes wrangler@4 pages deploy build --project-name=vanta-docs --branch=main",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "security:dependencies": "node scripts/dependency-audit.mjs",
    "security:dependencies:test": "node --test scripts/dependency-audit.node-test.mjs scripts/image-build-security.node-test.mjs scripts/worker-pool-security.node-test.mjs scripts/dependency-leaf-security.node-test.mjs",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "^3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "image-size": "2.0.4",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "^19.0.0",
    "typescript": "~6.0.2"
  },
  "overrides": {
    "@docusaurus/core@3.10.2": {
      "tinypool": "2.1.2"
    },
    "@docusaurus/theme-mermaid@^3.10.2": {
      "mermaid": {
        ".": "11.16.1",
        "katex": "0.18.2"
      }
    },
    "express@4.22.2": {
      "qs": "6.16.2"
    },
    "fast-uri": "3.1.9",
    "serialize-javascript": "7.1.3",
    "undici": "7.30.2",
    "uuid": "^11.1.1"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
