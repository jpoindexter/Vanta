#!/usr/bin/env bash
# Scan repository-owned content without treating ignored local state,
# dependencies, or rebuildable package output as source-controlled evidence.

set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks is required (install: brew install gitleaks)" >&2
  exit 1
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
CONFIG_PATH="$REPO_ROOT/.gitleaks.toml"
SCAN_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/vanta-secret-scan.XXXXXX")"

cleanup() {
  case "$SCAN_ROOT" in
    "${TMPDIR:-/tmp}"/vanta-secret-scan.*) rm -rf "$SCAN_ROOT" ;;
    *) echo "refusing to remove unexpected scan directory: $SCAN_ROOT" >&2 ;;
  esac
}
trap cleanup EXIT

cd "$REPO_ROOT"

echo "Scanning complete Git history..."
gitleaks git "$REPO_ROOT" \
  --config "$CONFIG_PATH" \
  --redact \
  --no-banner

echo "Scanning current tracked and non-ignored untracked files..."
while IFS= read -r -d '' scan_file; do
  if [[ -f "$scan_file" || -L "$scan_file" ]]; then
    mkdir -p "$SCAN_ROOT/$(dirname "$scan_file")"
    cp -Pp "$scan_file" "$SCAN_ROOT/$scan_file"
  fi
done < <(git ls-files -co --exclude-standard -z)

gitleaks dir "$SCAN_ROOT" \
  --config "$CONFIG_PATH" \
  --redact \
  --no-banner

echo "Repository-owned secret scan passed."
